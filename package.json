{
  "name": "yuval-elbar-security-research",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Security research portfolio — vulnerability writeups and CVEs by Yuval Elbar.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "build:static": "npm run build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/build-standalone.mjs",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "marked": "^17.0.1",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
